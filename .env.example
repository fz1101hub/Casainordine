# Create a Supabase project and paste its URL and publishable/anon key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A secret/service_role key, server ONLY. Never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Random strong password; configure it in Vercel Environment Variables.
CRON_SECRET=
# Optional: to send email reminders. Requires a verified sender domain.
RESEND_API_KEY=
RESEND_FROM=Casa in Ordine <promemoria@example.com>
# Production URL without a trailing slash, e.g. https://my-app.vercel.app
APP_URL=http://localhost:3000
# Gmail API per-user OAuth (separate from Supabase Google login).
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# 32 random bytes in base64, generated with: openssl rand -base64 32
MAIL_TOKEN_ENCRYPTION_KEY=
# Microsoft Graph delegated OAuth: personal Outlook/Hotmail/Live and Microsoft 365
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
# v1.8 optional Web Push via VAPID; generate with: npx web-push generate-vapid-keys
# Public base64url VAPID key. It is okay to expose this one.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private VAPID key: server ONLY. Do not prefix NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=
# A real contact email URI, e.g. mailto:admin@example.com
VAPID_SUBJECT=
